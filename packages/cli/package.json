{
  "name": "ts-semver-checks",
  "version": "0.3.0",
  "description": "Fail your build when a PR breaks your TypeScript package's public API but the version bump says otherwise.",
  "keywords": ["semver", "typescript", "api", "breaking-change", "types", "ci", "cli"],
  "homepage": "https://github.com/ardenden/ts-semver-checks#readme",
  "bugs": "https://github.com/ardenden/ts-semver-checks/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardenden/ts-semver-checks.git",
    "directory": "packages/cli"
  },
  "author": "ardenden",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ts-semver-checks": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ts-semver-checks-core": "workspace:^"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
